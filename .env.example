# Copy to backend/.env (or export these) to override defaults.

# Postgres connection (local dev defaults shown)
VF_DATABASE_URL=postgresql://visionflow:visionflow@127.0.0.1:5432/visionflow

# CV backend: "local" (default, real CPU detector), "simulate", or "patchcore"
VF_CV_BACKEND=local
# VF_MVTEC_ROOT=/path/to/mvtec/bottle
# VF_MVTEC_CATEGORY=bottle

# CORS: "*" for local dev; in production set to your deployed frontend origin,
# e.g. https://visionflow.vercel.app  (comma-separated for multiple).
VF_CORS_ORIGINS=*

# Decision thresholds on the anomaly score (0..1)
VF_T_LOW=0.35
VF_T_HIGH=0.65

# Artificial per-activity delay (ms) so the live flow is visible in the UI.
# Set to 0 for tests / max throughput.
VF_SIM_DELAY_MS=350
